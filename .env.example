# Server-only TomTom key. Do not prefix this with VITE_ or commit a real key.
TOMTOM_API_KEY=your_tomtom_api_key

# Optional backend port (Vite proxies /api here during local development).
API_PORT=8787

# PostgreSQL connection used by the backend.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liferoute

# Frontend origin allowed to call the API directly in production.
CLIENT_ORIGIN=http://localhost:5173

# Use a long random value outside local development.
JWT_SECRET=replace_with_a_long_random_secret
