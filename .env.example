# Server-only TomTom key. Do not prefix this with VITE_ or commit a real key.
TOMTOM_API_KEY=place holder

# Optional backend port (Vite proxies /api here during local development).
API_PORT=8787

# PostgreSQL connection used by the backend.
DATABASE_URL=placeholder

# Frontend origin allowed to call the API directly in production.
CLIENT_ORIGIN=http://localhost:5173

# Use a long random value outside local development.
JWT_SECRET=replace_with_a_long_random_secret

# Optional. If unset, hospital recommendations use the rules-based scorer
# in server/ai.mjs only (no behavior change). If set, Groq reviews that
# result and may add an explanation or override with a different vetted
# candidate. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
